          "lines": [
            {
              "line": 977,
              "text": "      // special case: single body on each side"
            },
            {
              "line": 978,
              "text": "      if ((con->geom[0] >= 0 || con->vert[0] >= 0) &&"
            },
            {
              "line": 979,
              "text": "          (con->geom[1] >= 0 || con->vert[1] >= 0)) {"
            },
            {
              "line": 980,
              "text": "        // get bodies"
            },
            {
              "line": 981,
              "text": "        int bid[2];"
            },
            {
              "line": 982,
              "text": "        for (int side=0; side < 2; side++) {"
            },
            {
              "line": 983,
              "text": "          bid[side] = (con->geom[side] >= 0) ?"
            },
            {
              "line": 984,
              "text": "                      m->geom_bodyid[con->geom[side]] :"
            },
            {
              "line": 985,
              "text": "                      m->flex_vertbodyid[m->flex_vertadr[con->flex[side]] + con->vert[side]];"
            },
            {
              "line": 986,
              "text": "        }"
            },
            {
              "line": 987,
              "text": ""
            },
            {
              "line": 988,
              "text": "        // compute Jacobian differences"
            },
            {
              "line": 989,
              "text": "        if (dim > 3) {"
            },
            {
              "line": 990,
              "text": "          NV = mj_jacDifPair(m, d, chain, bid[0], bid[1], con->pos, con->pos,"
            },
            {
              "line": 991,
              "text": "                             jac1p, jac2p, jacdifp, jac1r, jac2r, jacdifr);"
            },
            {
              "line": 992,
              "text": "        } else {"
            },
            {
              "line": 993,
              "text": "          NV = mj_jacDifPair(m, d, chain, bid[0], bid[1], con->pos, con->pos,"
            },
            {
              "line": 994,
              "text": "                             jac1p, jac2p, jacdifp, NULL, NULL, NULL);"
            },
            {
              "line": 995,
              "text": "        }"
            }
          ]
        },
        {
          "line_start": 1044,
          "line_end": 1048,
          "source_url": "https://github.com/google-deepmind/mujoco/blob/3.2.3/src/engine/engine_core_constraint.c#L1044-L1048",
          "lines": [
            {
              "line": 1044,
              "text": "      // rotate Jacobian differences to contact frame"
            },
            {
              "line": 1045,
              "text": "      mju_mulMatMat(jac, con->frame, jacdifp, dim > 1 ? 3 : 1, 3, NV);"
            },
            {
              "line": 1046,
              "text": "      if (dim > 3) {"
            },
            {
              "line": 1047,
              "text": "        mju_mulMatMat(jac + 3*NV, con->frame, jacdifr, dim-3, 3, NV);"
            },
            {
              "line": 1048,
              "text": "      }"
            }
          ]
        },
