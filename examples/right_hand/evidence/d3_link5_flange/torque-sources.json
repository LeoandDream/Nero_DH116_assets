            {
              "line": 655,
              "text": "// dense or sparse Jacobian difference for two body points: pos2 - pos1, global"
            },
            {
              "line": 656,
              "text": "int mj_jacDifPair(const mjModel* m, const mjData* d, int* chain,"
            },
            {
              "line": 657,
              "text": "                  int b1, int b2, const mjtNum pos1[3], const mjtNum pos2[3],"
            },
            {
              "line": 658,
              "text": "                  mjtNum* jac1p, mjtNum* jac2p, mjtNum* jacdifp,"
            },
            {
              "line": 659,
              "text": "                  mjtNum* jac1r, mjtNum* jac2r, mjtNum* jacdifr) {"
            }
          ]
        },
        {
