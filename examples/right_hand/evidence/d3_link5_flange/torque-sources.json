          "lines": [
            {
              "line": 87,
              "text": "      // apply fixed translation and rotation relative to parent"
            },
            {
              "line": 88,
              "text": "      if (pid) {"
            },
            {
              "line": 89,
              "text": "        mju_mulMatVec3(xpos, d->xmat+9*pid, bodypos);"
            },
            {
              "line": 90,
              "text": "        mju_addTo3(xpos, d->xpos+3*pid);"
            },
            {
              "line": 91,
              "text": "        mju_mulQuat(xquat, d->xquat+4*pid, bodyquat);"
            },
            {
              "line": 92,
              "text": "      } else {"
            },
            {
              "line": 93,
              "text": "        // parent is the world"
            },
            {
              "line": 94,
              "text": "        mju_copy3(xpos, bodypos);"
            },
            {
              "line": 95,
              "text": "        mju_copy4(xquat, bodyquat);"
            },
            {
              "line": 96,
              "text": "      }"
            },
            {
              "line": 97,
              "text": ""
            },
            {
              "line": 98,
              "text": "      // accumulate joints, compute xpos and xquat for this body"
            },
            {
              "line": 99,
              "text": "      mjtNum xanchor[3], xaxis[3];"
            },
            {
              "line": 100,
              "text": "      for (int j=0; j < jntnum; j++) {"
            },
            {
              "line": 101,
              "text": "        // get joint id, qpos address, joint type"
            },
            {
              "line": 102,
              "text": "        int jid = jntadr + j;"
            },
            {
              "line": 103,
              "text": "        int qadr = m->jnt_qposadr[jid];"
            },
            {
              "line": 104,
              "text": "        mjtJoint jtype = m->jnt_type[jid];"
            },
            {
              "line": 105,
              "text": ""
            },
            {
              "line": 106,
              "text": "        // compute axis in global frame; ball jnt_axis is (0,0,1), set by compiler"
            },
            {
              "line": 107,
              "text": "        mju_rotVecQuat(xaxis, m->jnt_axis+3*jid, xquat);"
            },
            {
