          "lines": [
            {
              "line": 1449,
              "text": "// extract 6D force:torque for one contact, in contact frame"
            },
            {
              "line": 1450,
              "text": "void mj_contactForce(const mjModel* m, const mjData* d, int id, mjtNum result[6]) {"
            },
            {
              "line": 1451,
              "text": "  mjContact* con;"
            },
            {
              "line": 1452,
              "text": ""
            },
            {
              "line": 1453,
              "text": "  // clear result"
            },
            {
              "line": 1454,
              "text": "  mju_zero(result, 6);"
            },
            {
              "line": 1455,
              "text": ""
            },
            {
              "line": 1456,
              "text": "  // make sure contact is valid"
            },
            {
              "line": 1457,
              "text": "  if (id >= 0 && id < d->ncon && d->contact[id].efc_address >= 0) {"
            },
            {
              "line": 1458,
              "text": "    // get contact pointer"
            },
            {
              "line": 1459,
              "text": "    con = d->contact + id;"
            },
            {
              "line": 1460,
              "text": ""
            },
            {
              "line": 1461,
              "text": "    if (mj_isPyramidal(m)) {"
            },
            {
              "line": 1462,
              "text": "      mju_decodePyramid(result, d->efc_force + con->efc_address, con->friction, con->dim);"
            },
            {
              "line": 1463,
              "text": "    } else {"
            },
            {
              "line": 1464,
              "text": "      mju_copy(result, d->efc_force + con->efc_address, con->dim);"
            },
            {
              "line": 1465,
              "text": "    }"
            },
            {
              "line": 1466,
              "text": "  }"
            },
            {
              "line": 1467,
              "text": "}"
            }
          ]
        }
      ]
