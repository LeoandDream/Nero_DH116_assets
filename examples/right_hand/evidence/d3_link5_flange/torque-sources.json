              "text": ""
            },
            {
              "line": 109,
              "text": "        // compute anchor in global frame"
            },
            {
              "line": 110,
              "text": "        mju_rotVecQuat(xanchor, m->jnt_pos+3*jid, xquat);"
            },
            {
              "line": 111,
              "text": "        mju_addTo3(xanchor, xpos);"
            }
          ]
        },
        {
          "line_start": 119,
          "line_end": 147,
          "source_url": "https://github.com/google-deepmind/mujoco/blob/3.2.3/src/engine/engine_core_smooth.c#L119-L147",
          "lines": [
            {
              "line": 119,
              "text": "        case mjJNT_BALL:"
            },
            {
              "line": 120,
              "text": "        case mjJNT_HINGE:"
            },
            {
              "line": 121,
              "text": "          {"
            },
            {
              "line": 122,
              "text": "            // compute local quaternion rotation"
            },
            {
              "line": 123,
              "text": "            mjtNum qloc[4];"
            },
            {
              "line": 124,
              "text": "            if (jtype == mjJNT_BALL) {"
            },
            {
              "line": 125,
              "text": "              mju_copy4(qloc, d->qpos+qadr);"
