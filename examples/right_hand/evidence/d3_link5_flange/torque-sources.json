          "source_url": "https://github.com/google-deepmind/mujoco/blob/3.2.3/src/engine/engine_forward.c#L883-L929",
          "lines": [
            {
              "line": 883,
              "text": "  // compute the remaining X[i], F[i]"
            },
            {
              "line": 884,
              "text": "  for (int i=1; i < N; i++) {"
            },
            {
              "line": 885,
              "text": "    // compute dX"
            },
            {
              "line": 886,
              "text": "    mju_zero(dX, 2*nv+na);"
            },
            {
              "line": 887,
              "text": "    for (int j=0; j < i; j++) {"
            },
            {
              "line": 888,
              "text": "      mju_addToScl(dX, X[j]+nq, A[(i-1)*(N-1)+j], nv);"
            },
            {
              "line": 889,
              "text": "      mju_addToScl(dX+nv, F[j], A[(i-1)*(N-1)+j], nv+na);"
            },
            {
              "line": 890,
              "text": "    }"
            },
            {
              "line": 891,
              "text": ""
            },
            {
              "line": 892,
              "text": "    // compute X[i] = X[0] '+' dX"
            },
            {
              "line": 893,
              "text": "    mju_copy(X[i], X[0], nq+nv+na);"
            },
            {
              "line": 894,
              "text": "    mj_integratePos(m, X[i], dX, h);"
            },
            {
              "line": 895,
              "text": "    mju_addToScl(X[i]+nq, dX+nv, h, nv+na);"
            },
            {
              "line": 896,
              "text": ""
            },
            {
              "line": 897,
              "text": "    // set X[i], T[i-1] in mjData"
            },
            {
              "line": 898,
              "text": "    mju_copy(d->qpos, X[i], nq);"
            },
            {
              "line": 899,
              "text": "    mju_copy(d->qvel, X[i]+nq, nv);"
            },
            {
              "line": 900,
              "text": "    if (na) {"
            },
            {
              "line": 901,
              "text": "      mju_copy(d->act, X[i]+nq+nv, na);"
            },
            {
              "line": 902,
              "text": "    }"
            },
            {
              "line": 903,
              "text": "    d->time = T[i-1];"
            },
            {
              "line": 904,
              "text": ""
            },
            {
              "line": 905,
              "text": "    // evaluate F[i]"
            },
            {
              "line": 906,
              "text": "    mj_forwardSkip(m, d, mjSTAGE_NONE, 1);  // 1: do not recompute sensors and energy"
            },
            {
              "line": 907,
              "text": "    mju_copy(F[i], d->qacc, nv);"
            },
            {
              "line": 908,
              "text": "    if (na) {"
            },
            {
              "line": 909,
              "text": "      mju_copy(F[i]+nv, d->act_dot, na);"
            },
            {
              "line": 910,
              "text": "    }"
            },
            {
              "line": 911,
              "text": "  }"
            },
            {
              "line": 912,
              "text": ""
            },
            {
              "line": 913,
              "text": "  // compute dX for final update (using B instead of A)"
            },
            {
              "line": 914,
              "text": "  mju_zero(dX, 2*nv+na);"
            },
            {
              "line": 915,
              "text": "  for (int j=0; j < N; j++) {"
            },
            {
              "line": 916,
              "text": "    mju_addToScl(dX, X[j]+nq, B[j], nv);"
            },
            {
              "line": 917,
              "text": "    mju_addToScl(dX+nv, F[j], B[j], nv+na);"
            },
            {
              "line": 918,
              "text": "  }"
            },
            {
              "line": 919,
              "text": ""
            },
            {
              "line": 920,
              "text": "  // reset state and time"
            },
            {
              "line": 921,
              "text": "  d->time = time;"
            },
            {
              "line": 922,
              "text": "  mju_copy(d->qpos, X[0], nq);"
            },
            {
              "line": 923,
              "text": "  mju_copy(d->qvel, X[0]+nq, nv);"
            },
            {
              "line": 924,
              "text": "  mju_copy(d->act, X[0]+nq+nv, na);"
            },
            {
              "line": 925,
              "text": ""
