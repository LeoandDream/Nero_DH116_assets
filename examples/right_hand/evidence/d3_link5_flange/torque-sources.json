              "text": "              mju_normalize4(qloc);"
            },
            {
              "line": 127,
              "text": "            } else {"
            },
            {
              "line": 128,
              "text": "              mju_axisAngle2Quat(qloc, m->jnt_axis+3*jid, d->qpos[qadr] - m->qpos0[qadr]);"
            },
            {
              "line": 129,
              "text": "            }"
            },
            {
              "line": 130,
              "text": ""
            },
            {
              "line": 131,
              "text": "            // apply rotation"
            },
            {
              "line": 132,
              "text": "            mju_mulQuat(xquat, xquat, qloc);"
            },
            {
              "line": 133,
              "text": ""
            },
            {
              "line": 134,
              "text": "            // correct for off-center rotation"
            },
            {
              "line": 135,
              "text": "            mjtNum vec[3];"
            },
            {
              "line": 136,
              "text": "            mju_rotVecQuat(vec, m->jnt_pos+3*jid, xquat);"
            },
            {
              "line": 137,
              "text": "            mju_sub3(xpos, xanchor, vec);"
            },
            {
              "line": 138,
              "text": "          }"
            },
            {
              "line": 139,
              "text": "          break;"
