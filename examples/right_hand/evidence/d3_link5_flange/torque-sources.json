          "line_end": 724,
          "source_url": "https://github.com/google-deepmind/mujoco/blob/3.2.3/src/engine/engine_support.c#L696-L724",
          "lines": [
            {
              "line": 696,
              "text": "    // regular processing"
            },
            {
              "line": 697,
              "text": "    else {"
            },
            {
              "line": 698,
              "text": "      // Jacobians"
            },
            {
              "line": 699,
              "text": "      mj_jacSparse(m, d, jac1p, jac1r, pos1, b1, NV, chain);"
            },
            {
              "line": 700,
              "text": "      mj_jacSparse(m, d, jac2p, jac2r, pos2, b2, NV, chain);"
            },
            {
              "line": 701,
              "text": ""
            },
            {
              "line": 702,
              "text": "      // differences"
            },
            {
              "line": 703,
              "text": "      if (jacdifp) {"
            },
            {
              "line": 704,
              "text": "        mju_sub(jacdifp, jac2p, jac1p, 3*NV);"
            },
            {
              "line": 705,
              "text": "      }"
            },
            {
              "line": 706,
              "text": "      if (jacdifr) {"
            },
            {
              "line": 707,
              "text": "        mju_sub(jacdifr, jac2r, jac1r, 3*NV);"
            },
            {
              "line": 708,
              "text": "      }"
            },
            {
              "line": 709,
              "text": "    }"
            },
            {
              "line": 710,
              "text": "  }"
            },
            {
              "line": 711,
              "text": ""
            },
            {
              "line": 712,
              "text": "  // dense case"
            },
            {
              "line": 713,
              "text": "  else {"
            },
            {
              "line": 714,
              "text": "    // Jacobians"
            },
            {
              "line": 715,
              "text": "    mj_jac(m, d, jac1p, jac1r, pos1, b1);"
            },
            {
              "line": 716,
              "text": "    mj_jac(m, d, jac2p, jac2r, pos2, b2);"
            },
            {
              "line": 717,
              "text": ""
            },
            {
              "line": 718,
              "text": "    // differences"
            },
            {
              "line": 719,
              "text": "    if (jacdifp) {"
            },
            {
              "line": 720,
              "text": "      mju_sub(jacdifp, jac2p, jac1p, 3*NV);"
            },
            {
              "line": 721,
              "text": "    }"
            },
            {
              "line": 722,
              "text": "    if (jacdifr) {"
            },
            {
              "line": 723,
              "text": "      mju_sub(jacdifr, jac2r, jac1r, 3*NV);"
            },
            {
              "line": 724,
